#!/bin/sh
# Stub for curl (the in-box Zed server fetch): logs argv, writes a gzip of
# "SERVER <url>" to the -o path; STUB_CURL_FAIL=1 fails without output.
echo "curl $*" >> "$STUB_LOG"
[ -z "${STUB_CURL_FAIL:-}" ] || exit 22
o='' u=''
while [ $# -gt 0 ]; do
    case $1 in -o) o=$2; shift 2 ;; -*) shift ;; *) u=$1; shift ;; esac
done
printf 'SERVER %s\n' "$u" | gzip -c > "$o"
