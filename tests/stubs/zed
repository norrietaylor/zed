#!/bin/sh
# Stub for the zed CLI: logs argv; `--version` answers like Zed 1.22
# ("Zed 1.22.0 – /Applications/Zed.app"), or $STUB_ZED_VERSION_LINE.
echo "zed $*" >> "$STUB_LOG"
if [ "${1:-}" = --version ]; then
    printf '%s\n' "${STUB_ZED_VERSION_LINE:-Zed 1.22.0 – /Applications/Zed.app}"
fi
exit 0
