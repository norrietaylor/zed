#!/bin/sh
# Stub for herdr, used only by the kernel's Herdr-bridge rule: logs argv to
# $STUB_LOG; box NAME's agents (asked as `--machine ANYPREFIX.NAME agent
# list`) come from $FIXTURES/herdr.agents.NAME.json, none by default.
echo "herdr $*" >> "$STUB_LOG"
if [ "${1:-}" = --machine ] && [ "${3:-} ${4:-}" = "agent list" ]; then
    # $FIXTURES/herdr.agents.NAME.fail: the query fails (box unreachable, herdr error)
    [ ! -f "$FIXTURES/herdr.agents.${2##*.}.fail" ] || { echo "error: connection lost" >&2; exit 1; }
    cat "$FIXTURES/herdr.agents.${2##*.}.json" 2>/dev/null || echo '{"result":{"agents":[],"type":"agent_list"}}'
fi
exit 0
