#!/bin/sh
# min-zed — Minimal sessions as Zed remote projects.
#
# min names a session, and it is reached as `min-zed.NAME`: stock ssh whose
# ProxyCommand runs an OpenSSH sshd *inside* the box through
# `min session exec`. `open` makes the session, writes its ssh stanza and
# Zed's ssh_connections entry, then runs `zed ssh://min-zed.NAME/workbench`.
#
# Layout: tool constants, then transport, ssh and session plumbing, then the
# Zed layer, whose first block holds every editor-specific value.
set -eu

# ---- tool constants ------------------------------------------------------------
TOOL=min-zed
LOADOUT=zed
HOST_PREFIX=min-zed.
ENV_PREFIX=MIN_ZED
STATE=${MIN_ZED_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/min-zed}

# The Zed layer below may define the hooks client_linked NAME (0: its UI
# holds the session), client_on_connect NAME and client_on_destroy NAME;
# undefined ones do nothing.

eval "DEBUG=\${${ENV_PREFIX}_DEBUG:-}"
SSH_KEYGEN=${SSH_KEYGEN_BIN:-ssh-keygen}
SELF=$(cd "$(dirname "$0")" && pwd -P)/$(basename "$0")
# GUI apps and hooks run us with a bare system PATH (tests turn this off).
[ "${MIN_NO_PATH_EXTEND:-}" = 1 ] || PATH=$PATH:/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin
SSH_DIR=$HOME/.ssh
SSH_CONF=$SSH_DIR/$TOOL.conf          # one `Host <prefix>NAME` stanza per session; ours
SSH_MAIN=$SSH_DIR/config              # the user's; gets a marked Include at the top
SSH_MARK1="# $TOOL ssh-config (remove with: $TOOL ssh-config --remove)"
SSH_MARK2="Include ~/.ssh/$TOOL.conf"
# What the first min-<client> ssh-config created under ~/.ssh (`dir`,
# `config`), one word per line; shared by every tool, so whichever removes
# the last Include deletes them.
SSH_CREATED=${XDG_STATE_HOME:-$HOME/.local/state}/min-clients/ssh-config-created
SSH_LOCK=${SSH_CREATED%/*}/ssh-config.lock   # held by any tool rewriting ~/.ssh/config

die() { printf '%s: %s\n' "$TOOL" "$*" >&2; exit 1; }
log() { printf '[%s] %s\n' "$TOOL" "$*" >&2; }
dbg() { [ -n "$DEBUG" ] && log "$@"; return 0; }

# hook NAME ARGS...: the client layer's NAME when it defines one. Undefined,
# client_linked says "not linked" and the others do nothing.
hook() {
    if command -v "$1" >/dev/null 2>&1; then "$@"; return; fi
    [ "$1" != client_linked ]
}

# ---- transport -------------------------------------------------------------

# Absolute path of the min binary: it becomes the ssh ProxyCommand, which
# /usr/bin/ssh runs without the user's shell functions or PATH.
resolve_min() {
    m=${MIN_BIN:-min}
    case $m in
        /*) ;;
        *) m=$(command -v "$m" 2>/dev/null) || die "min not found on PATH (set MIN_BIN)" ;;
    esac
    [ -x "$m" ] || die "min is not executable: $m"
    printf '%s' "$m"
}

# Quote one word for `sh -c` (ssh runs ProxyCommand through the shell) and
# double every % so ssh's own token expansion leaves it alone.
shq() {
    case $1 in
        '') printf "''" ;;
        *[!A-Za-z0-9/._+:@,=-]*) printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")" ;;
        *) printf '%s' "$1" ;;
    esac
}
pct() { printf '%s' "$1" | sed 's/%/%%/g'; }

mn() { "$MIN" "$@"; }
min_ls() { mn ls --json </dev/null; }
# own_filter: min ls --json on stdin, narrowed to the sessions this tool has
# prepared (a key dir under $STATE/sessions). gc, orphan reminders, open's
# reuse, destroy's cwd lookup, the attach picker and completions use only
# these: other tools' boxes are theirs. own_ls: the same from min ls.
own_filter() {
    ol_mine=$(for s in "$STATE"/sessions/*/; do if [ -d "$s" ]; then basename "$s"; fi; done)
    jq --arg m "$ol_mine" '($m | split("\n")) as $k | .sessions |= map(select(.name as $n | $k | index([$n])))'
}
own_ls() { ol_j=$(min_ls) || return 1; printf '%s' "$ol_j" | own_filter; }
# sess_field NAME FIELD  (id | project_path | status | branch)
sess_field() {
    min_ls | jq -r --arg n "$1" --arg f "$2" '
        .sessions[] | select(.name == $n)
        | if $f == "branch" then (.git.branch // empty) else (.[$f] // empty) end' | head -1
}
sess_exists() { [ -n "$(sess_field "$1" id)" ]; }

# ---- keys and facts --------------------------------------------------------

sess_dir() { printf '%s/sessions/%s' "$STATE" "$1"; }

ensure_keypair() {
    d=$(sess_dir "$1")
    mkdir -p "$d" && chmod 700 "$d"
    [ -s "$d/id_ed25519" ] && return 0
    "$SSH_KEYGEN" -q -t ed25519 -N '' -C "$TOOL:$1" -f "$d/id_ed25519" </dev/null \
        || die "ssh-keygen failed for $1"
    chmod 600 "$d/id_ed25519"
}

# put FILE LINE: FILE becomes LINE (newline-terminated) in one rename, so a
# concurrent reader never sees it half written.
put() {
    t=$(mktemp "$(dirname "$1")/.tmp.XXXXXX") && printf '%s\n' "$2" > "$t" && mv -f "$t" "$1"
}

# Runs inside the box via `min session exec NAME sh -c PREP TOOL PUBKEY`.
# Prints key=value facts on stdout; anything else is an error.
# The box's host key and authorized_keys live in ~/.ssh/TOOL.
# Host key: while either half of the pair is missing, the PREP that makes the
# .keygen dir generates into a temp name, drops any leftover half, and renames
# the new pair into place; everyone else waits for both files. Only that PREP
# removes the dir. Waiters give up after 5s (MIN_KEYGEN_WAIT: a test knob,
# min does not forward host env) leaving the dir alone. A dir over a minute
# old (owner died) is broken by one waiter at a time, under .keygen.break,
# which is itself cleared when over a minute old; without `find -mmin`
# neither is ever broken.
# The rc line moves interactive shells that start in $HOME to /workbench.
# A box with Minimal's claude package (`min add claude`: /usr/bin/claude, a
# wrapper loading Minimal's Claude plugin) gets CLAUDE_CODE_EXECUTABLE in
# the sshd environment, so Zed's Claude Agent (its ACP adapter honours the
# variable) runs that claude instead of the SDK's own; a value already set
# in the box wins. MIN_BOX_CLAUDE is a test knob, like MIN_KEYGEN_WAIT.
# shellcheck disable=SC2016
PREP='set -eu
umask 077
case $0 in ""|*[!a-z0-9-]*) echo "bad tool name: $0" >&2; exit 3 ;; esac
s="$HOME/.ssh"; a="$s/$0"; d="$a"; k="$d/host_ed25519"; l="$d/.keygen"
mkdir -p "$s" "$a"
command -v ssh-keygen >/dev/null 2>&1 || { echo "openssh is not installed in this session; activate it with --loadout zed" >&2; exit 3; }
unlock() { rm -f "$t" "$t.pub"; rmdir "$l" 2>/dev/null || true; }
old() { [ -n "$(find "$1" -prune -mmin +1 2>/dev/null)" ]; }
i=0
while [ ! -s "$k" ] || [ ! -s "$k.pub" ]; do
  if mkdir "$l" 2>/dev/null; then
    t="$d/.new.$$"; trap unlock EXIT; trap "exit 1" HUP INT TERM
    if [ ! -s "$k" ] || [ ! -s "$k.pub" ]; then
      rm -f "$t" "$t.pub"
      ssh-keygen -q -t ed25519 -N "" -C "min host" -f "$t" </dev/null >&2
      rm -f "$k" "$k.pub"
      mv -f "$t" "$k"; mv -f "$t.pub" "$k.pub"
    fi
    trap - EXIT HUP INT TERM; unlock
    break
  fi
  if old "$l.break"; then rmdir "$l.break" 2>/dev/null || true; fi
  if old "$l" && mkdir "$l.break" 2>/dev/null; then
    ! old "$l" || rm -rf "$l"
    rmdir "$l.break"; continue
  fi
  [ "$i" -lt "${MIN_KEYGEN_WAIT:-5}" ] || { echo "host key generation did not finish in $d ($l is held)" >&2; exit 3; }
  sleep 1; i=$((i + 1))
done
printf "%s\n" "$1" > "$a/authorized_keys.$$" && mv -f "$a/authorized_keys.$$" "$a/authorized_keys"
env | grep -E "^[A-Za-z_][A-Za-z0-9_]*=" | grep -Ev "^(TERM|PWD|OLDPWD|SHLVL|_|HOME|USER|LOGNAME|PATH|SSH_[A-Z_]*|PROMPT_COMMAND|MINIMAL_MOTD)=" > "$s/environment.$$" || true
c=${MIN_BOX_CLAUDE:-/usr/bin/claude}
if [ -x "$c" ] && [ -z "${CLAUDE_CODE_EXECUTABLE:-}" ]; then echo "CLAUDE_CODE_EXECUTABLE=$c" >> "$s/environment.$$"; fi
mv -f "$s/environment.$$" "$s/environment"
for rc in "$HOME/.bashrc" "$HOME/.zshrc"; do
  grep -qs "min:workbench" "$rc" || printf "%s\n" "# min:workbench (managed by $0)" "case \$- in *i*) if [ \"\$PWD\" = \"\$HOME\" ] && [ -d /workbench ]; then cd /workbench; fi ;; esac" >> "$rc"
done
[ -e "$HOME/.bash_profile" ] || printf "%s\n" "[ -f \"\$HOME/.bashrc\" ] && . \"\$HOME/.bashrc\"" > "$HOME/.bash_profile"
echo "user=$(id -un)"
echo "home=$HOME"
echo "sshd=$(command -v sshd 2>/dev/null || echo /usr/sbin/sshd)"
echo "hostkey=$(cut -d" " -f1-2 "$k.pub")"'

# prepare NAME: key on the host, pubkey + host key in the box, facts on disk.
# Also the /workbench shell line for sessions activated before the loadout.
# Sets $F_USER $F_HOME $F_SSHD.
prepare() {
    valid_name "$1" || die "session name is not lowercase letters, digits and dashes; not using it: $(printf '%s' "$1" | LC_ALL=C tr -c '[:print:]' '?')"
    ensure_keypair "$1"
    d=$(sess_dir "$1")
    pub=$(cat "$d/id_ed25519.pub") || die "cannot read $d/id_ed25519.pub"
    facts=$(mn session exec "$1" sh -c "$PREP" "$TOOL" "$pub" </dev/null) \
        || die "could not prepare session $1 (is it active, with openssh installed?)"
    F_USER=$(printf '%s\n' "$facts" | sed -n 's/^user=//p' | head -1)
    F_HOME=$(printf '%s\n' "$facts" | sed -n 's/^home=//p' | head -1)
    F_SSHD=$(printf '%s\n' "$facts" | sed -n 's/^sshd=//p' | head -1)
    hostkey=$(printf '%s\n' "$facts" | sed -n 's/^hostkey=//p' | head -1)
    [ -n "$F_USER" ] && [ -n "$F_HOME" ] && [ -n "$hostkey" ] \
        || die "session $1 returned incomplete facts: $(printf '%s' "$facts" | LC_ALL=C tr -c '[:print:]\n' '?' | head -c 400)"
    : "${F_SSHD:=/usr/sbin/sshd}"
    # The box is untrusted: these land in ssh_config (User expands %tokens
    # and ${ENV}) and in the ProxyCommand. Check all before writing any.
    fact_ok "$USER_ERE" "$F_USER" || bad_fact "$1" user "$F_USER"
    fact_ok 'ssh-ed25519 [A-Za-z0-9+/]+=*' "$hostkey" || bad_fact "$1" hostkey "$hostkey"
    fact_ok "$PATH_ERE" "$F_HOME" || bad_fact "$1" home "$F_HOME"
    fact_ok "$PATH_ERE" "$F_SSHD" || bad_fact "$1" sshd "$F_SSHD"
    umask 077
    # explicit: _proxy runs prepare under `||`, where set -e does not apply
    if ! { put "$d/known_hosts" "$HOST_PREFIX$1 $hostkey" && put "$d/user" "$F_USER" \
            && put "$d/home" "$F_HOME" && put "$d/sshd" "$F_SSHD"; }; then
        die "could not write the facts for $1 under $d"
    fi
    ssh_config_write
}

# What a box may report. Paths: no space (sshd's AuthorizedKeysFile splits on
# it), no quoting or %/$ expansion, no control bytes (proxy_command's
# \001/\002 sentinels among them).
USER_ERE='[A-Za-z_][A-Za-z0-9._-]{0,31}'
PATH_ERE='/[A-Za-z0-9._/+@-]*'
# fact_ok ERE VALUE: VALUE is one line matching ERE in full (C locale). The
# newline check matters for values read back from disk ($d/user).
fact_ok() {
    case $2 in *"
"*) return 1 ;; esac
    printf '%s\n' "$2" | LC_ALL=C grep -Eqx -- "$1"
}
# stored_path NAME FIELD: the path prepare stored in sessions/NAME/FIELD (home,
# sshd), re-checked on read; status 1 when it is missing or not a valid path.
stored_path() {
    sp=$(cat "$(sess_dir "$1")/$2" 2>/dev/null) && fact_ok "$PATH_ERE" "$sp" || return 1
    printf '%s' "$sp"
}
# bad_fact NAME FIELD VALUE: die naming the field; VALUE cut to 40 printable bytes.
bad_fact() {
    v=$(printf '%s' "$3" | LC_ALL=C tr -c '[:print:]' '?' | cut -c1-40)
    die "session $1 reported an invalid $2 ($v); not trusting it"
}

# sshd argv, one word per line. $1 sshd path, $2 box home.
sshd_argv() {
    printf '%s\n' "$1" -i -e -f /dev/null -h "$2/.ssh/$TOOL/host_ed25519" \
        -o LogLevel=ERROR -o PidFile=none -o StrictModes=no \
        -o PubkeyAuthentication=yes -o PasswordAuthentication=no \
        -o KbdInteractiveAuthentication=no \
        -o "AuthorizedKeysFile $2/.ssh/$TOOL/authorized_keys" \
        -o PermitUserEnvironment=yes -o AllowTcpForwarding=yes -o GatewayPorts=no \
        -o AllowAgentForwarding=no -o X11Forwarding=no -o PrintMotd=no -o PrintLastLog=no -o UseDNS=no \
        -o "Subsystem sftp internal-sftp"
}

# ---- ssh -------------------------------------------------------------------

# The ProxyCommand string for NAME (facts from disk).
proxy_command() {
    d=$(sess_dir "$1")
    sshd=$(stored_path "$1" sshd) || die "session $1: invalid sshd in $d/sshd; not using it"
    home=$(stored_path "$1" home) || die "session $1: invalid home in $d/home; not using it"
    cmd="$(shq "$MIN") session exec $(shq "$1")"
    set -f
    for w in $(sshd_argv "$sshd" "$home" | tr '\n' '\001' | tr ' ' '\002' | tr '\001' ' '); do
        w=$(printf '%s' "$w" | tr '\002' ' ')
        cmd="$cmd $(shq "$w")"
    done
    set +f
    pct "$cmd"
}

# ssh_common NAME FMT: the client options every path to NAME carries (the
# client's own ssh, `TOOL ssh`, the TOOL.conf stanza), as `FMT KEY VALUE
# [path]`. Forwarding is off here, not left to ~/.ssh/config: TOOL.conf is
# Included first, so a later `Host *` with `ForwardAgent yes` would otherwise
# hand the agent to the box.
ssh_common() {
    d=$(sess_dir "$1")
    $2 User "$(cat "$d/user")"
    $2 IdentitiesOnly yes
    $2 AddKeysToAgent no
    $2 UserKnownHostsFile "$d/known_hosts" path
    $2 StrictHostKeyChecking yes
    $2 ForwardAgent no
    $2 ForwardX11 no
    $2 ForwardX11Trusted no
}

# KEY=VALUE for ssh -o; a path is quoted only when it has whitespace.
opt_kv() {
    v=$2
    if [ "${3:-}" = path ]; then
        case $v in *[[:space:]]*) v="\"$v\"" ;; esac
        v=$(pct "$v")
    fi
    printf '%s=%s\n' "$1" "$v"
}

# ssh -o options for NAME, one per line.
ssh_opts() {
    d=$(sess_dir "$1")
    fact_ok "$USER_ERE" "$(cat "$d/user")" || die "session $1: invalid user in $d/user; not using it"
    pc=$(proxy_command "$1") || exit 1
    printf '%s\n' "ProxyCommand=$pc"
    ssh_common "$1" opt_kv
}

# The path baked into stanzas: ~/.local/bin/TOOL when that symlink is this
# file (a moved checkout then keeps working), else this file.
self_path() {
    p=$HOME/.local/bin/$TOOL
    if [ -L "$p" ]; then
        l=$(readlink "$p"); case $l in /*) ;; *) l=$(dirname "$p")/$l ;; esac
        if [ -f "$l" ] && [ "$(cd "$(dirname "$l")" && pwd -P)/$(basename "$l")" = "$(cd "$(dirname "$SELF")" && pwd -P)/$(basename "$SELF")" ]; then
            printf '%s' "$p"; return 0
        fi
    fi
    printf '%s' "$SELF"
}

# One stanza line; a path is always quoted and %-doubled.
stanza_kv() {
    if [ "${3:-}" = path ]; then printf '    %s "%s"\n' "$1" "$(pct "$2")"
    else printf '    %s %s\n' "$1" "$2"; fi
}

# ssh_stanza NAME: a `Host <prefix>NAME` block from the facts prepare wrote.
# Paths are quoted and %-doubled: ssh expands tokens in all three values.
ssh_stanza() {
    d=$(sess_dir "$1")
    mb=; [ -z "$MIN" ] || mb="MIN_BIN=$(shq "$MIN") "
    printf '# %s\nHost %s%s\n' "$1" "$HOST_PREFIX" "$1"
    ssh_common "$1" stanza_kv
    stanza_kv IdentityFile "$d/id_ed25519" path
    printf '    ProxyCommand %s\n' "$(pct "env ${mb}${ENV_PREFIX}_STATE_DIR=$(shq "$STATE") $(shq "$(self_path)") _proxy $(shq "$1")")"
}

# The whole TOOL.conf: header, a stanza per session on disk (only those min
# still lists, when min is around), then a catch-all that explains itself.
ssh_stanzas() {
    printf '# managed by %s ssh-config; do not edit\n' "$TOOL"
    # One min ls; when it fails the stanzas on disk are kept.
    live=; filter=
    if [ -n "$MIN" ] && ls_json=$(min_ls 2>/dev/null); then
        live=$(printf '%s\n' "$ls_json" | jq -r '.sessions[].name'); filter=1
    fi
    for s in "$STATE"/sessions/*/; do
        [ -f "${s}user" ] || continue
        n=$(basename "$s")
        valid_name "$n" || { log "skipping $n: not a valid stanza name"; continue; }
        fact_ok "$USER_ERE" "$(cat "${s}user")" || { log "skipping $n: invalid user in ${s}user"; continue; }
        if [ -n "$filter" ]; then printf '%s\n' "$live" | grep -qxF -- "$n" || continue; fi
        printf '\n'; ssh_stanza "$n"
    done
    printf '\nHost %s* !%s*.*\n    ProxyCommand %s\n' "$HOST_PREFIX" "$HOST_PREFIX" \
        "$(pct "env ${ENV_PREFIX}_STATE_DIR=$(shq "$STATE") $(shq "$(self_path)") _proxy --missing")"
}

# stanza_names [FILE]: the session names of the stanzas in TOOL.conf (the
# catch-all is not one).
stanza_names() {
    awk -v p="Host $HOST_PREFIX" 'index($0, p) == 1 && length($0) > length(p) && substr($0, length(p) + 1, 1) != "*" {
        print substr($0, length(p) + 1) }' "${1:-$SSH_CONF}" 2>/dev/null || :
}
ssh_stanza_count() { stanza_names | grep -c . || :; }

# Refresh TOOL.conf. A no-op until `TOOL ssh-config` has created it (nothing
# under ~/.ssh is touched before that opt-in), and never fatal: it runs on
# the way to a connection, which matters more than a fresh stanza.
ssh_config_write() {
    [ -e "$SSH_CONF" ] || return 0
    case $STATE in *'"'*) log "state dir path contains a double quote; not writing $SSH_CONF"; return 0 ;; esac
    ssh_config_put || log "could not write $SSH_CONF; leaving it as it was"
    return 0
}
# TOOL.conf from ssh_stanzas: tmp + rename in place, mode 600; left alone
# (same inode, same mtime) when the content is unchanged.
ssh_config_put() {
    tmp=$(mktemp "$SSH_CONF.XXXXXX") || return 1
    ssh_stanzas > "$tmp" || { rm -f "$tmp"; return 1; }
    if cmp -s "$tmp" "$SSH_CONF"; then rm -f "$tmp"; chmod 600 "$SSH_CONF"; return 0; fi
    { chmod 600 "$tmp" && mv -f "$tmp" "$SSH_CONF"; } || { rm -f "$tmp"; return 1; }
}

# lock_old PATH: PATH is over a minute old (without `find -mmin`, never).
lock_old() { [ -n "$(find "$1" -prune -mmin +1 2>/dev/null)" ]; }

# ssh_lock: hold SSH_LOCK (a dir, shared by every min-<client> tool) for a
# read-modify-write of ~/.ssh/config and the created record; released on
# exit. A lock over a minute old (its holder died) is broken by one waiter
# at a time, under .break, as in PREP. Gives up after MIN_LOCK_WAIT seconds.
ssh_lock() {
    mkdir -p "${SSH_LOCK%/*}"
    i=0
    until mkdir "$SSH_LOCK" 2>/dev/null; do
        if lock_old "$SSH_LOCK.break"; then rmdir "$SSH_LOCK.break" 2>/dev/null || :; fi
        if lock_old "$SSH_LOCK" && mkdir "$SSH_LOCK.break" 2>/dev/null; then
            ! lock_old "$SSH_LOCK" || rm -rf "$SSH_LOCK"
            rmdir "$SSH_LOCK.break"; continue
        fi
        [ "$i" -lt "${MIN_LOCK_WAIT:-10}" ] || die "$SSH_LOCK is held by another ssh-config run; try again (remove it if none is running)"
        sleep 1; i=$((i + 1))
    done
    trap ssh_unlock EXIT
    trap 'exit 1' HUP INT TERM
}
ssh_unlock() {
    rmdir "$SSH_LOCK" 2>/dev/null || :
    rmdir "${SSH_LOCK%/*}" 2>/dev/null || :   # gone with the record, when it is
}

# Other tools' Include lines of the same shape in ~/.ssh/config: never touched.
ssh_other_includes() {
    grep -Ex 'Include ~/\.ssh/min-[a-z0-9-]+\.conf' "$SSH_MAIN" 2>/dev/null | grep -vxF -- "$SSH_MARK2" || :
}

# ssh-config [--remove|--print]: create ~/.ssh/TOOL.conf and put a marked
# Include of it at the top of ~/.ssh/config. ~/.ssh/config is written
# through, never renamed: it is often a dotfiles symlink. What the first
# min-<client> install created (`dir` for ~/.ssh, `config` for
# ~/.ssh/config) is recorded in $SSH_CREATED; a tool installed beside
# another leaves the record alone, and the one removing the last Include
# deletes only those.
cmd_ssh_config() {
    case ${1:-} in
        '') ;;
        --print) ssh_stanzas; return 0 ;;
        --remove) ssh_config_remove; return 0 ;;
        *) die "ssh-config: unknown option $1" ;;
    esac
    case $STATE in *'"'*) die "state dir path contains a double quote; not writing $SSH_CONF" ;; esac
    mkdir -p "$STATE"
    ssh_lock
    created=
    [ -d "$SSH_DIR" ] || { mkdir -p "$SSH_DIR" && chmod 700 "$SSH_DIR"; created=dir; }
    [ -e "$SSH_CONF" ] || { : > "$SSH_CONF"; chmod 600 "$SSH_CONF"; }
    if ! grep -qxF -- "$SSH_MARK2" "$SSH_MAIN" 2>/dev/null; then
        [ -e "$SSH_MAIN" ] || { : > "$SSH_MAIN"; chmod 600 "$SSH_MAIN"; created="$created config"; }
        if [ -z "$(ssh_other_includes)" ]; then
            # the first tool in: the record says what this install created, nothing older
            mkdir -p "$(dirname "$SSH_CREATED")"
            rm -f "$SSH_CREATED"
            for w in $created; do printf '%s\n' "$w" >> "$SSH_CREATED"; done
        fi
        tmp=$(mktemp "$SSH_MAIN.XXXXXX") || die "cannot write $SSH_MAIN"
        { printf '%s\n' "$SSH_MARK1" "$SSH_MARK2"; cat "$SSH_MAIN"; } > "$tmp"
        ssh_main_write "$tmp" || { rm -f "$tmp"; die "cannot write $SSH_MAIN"; }
        rm -f "$tmp"
        log "added \`$SSH_MARK2\` to the top of $SSH_MAIN"
    fi
    ssh_config_put || die "cannot write $SSH_CONF"
    log "$SSH_CONF: $(ssh_stanza_count) stanza(s); ssh ${HOST_PREFIX}NAME reaches a session"
}

# ssh_main_write FILE: ~/.ssh/config becomes FILE's content, written
# through, after a dated copy of its old content under $STATE/backups.
ssh_main_write() {
    (umask 077; mkdir -p "$STATE/backups") && chmod 700 "$STATE/backups" || return 1
    b=$STATE/backups/ssh_config.$(date +%Y%m%dT%H%M%S); i=1; bb=$b
    while [ -e "$bb" ]; do bb=$b.$i; i=$((i + 1)); done
    { (umask 077; cat "$SSH_MAIN" > "$bb") && chmod 600 "$bb"; } || { log "cannot back up $SSH_MAIN to $bb"; return 1; }
    log "backed up $SSH_MAIN to $bb"
    cat "$1" > "$SSH_MAIN" && return 0
    log "writing $SSH_MAIN failed; its previous content is in $bb"
    if cat "$bb" > "$SSH_MAIN"; then log "restored $SSH_MAIN from $bb"
    else log "could not restore $SSH_MAIN; copy $bb back by hand"; fi
    return 1
}

# Drop every marker + Include pair of ours from ~/.ssh/config (the rest byte
# for byte, a last line without a newline included) in one write, delete
# TOOL.conf, and, when no other tool's Include is left, the config file and
# ~/.ssh too if the first install created them and they are now empty (a
# symlinked config never).
ssh_config_remove() {
    ssh_lock
    removed=
    if grep -qxF -- "$SSH_MARK2" "$SSH_MAIN" 2>/dev/null; then
        tmp=$(mktemp "$SSH_MAIN.XXXXXX") || die "cannot write $SSH_MAIN"
        cat "$SSH_MAIN" > "$tmp"
        while n=$(grep -nxF -- "$SSH_MARK2" "$tmp" | head -1 | cut -d: -f1) && [ -n "$n" ]; do
            m=$n
            [ "$n" -gt 1 ] && [ "$(sed -n "$((n - 1))p" "$tmp")" = "$SSH_MARK1" ] && m=$((n - 1))
            { { [ "$m" -le 1 ] || head -n $((m - 1)) "$tmp"; tail -n +$((n + 1)) "$tmp"; } > "$tmp.next" \
                && mv -f "$tmp.next" "$tmp"; } || { rm -f "$tmp" "$tmp.next"; die "cannot write $SSH_MAIN"; }
        done
        ssh_main_write "$tmp" || { rm -f "$tmp"; die "cannot write $SSH_MAIN"; }
        rm -f "$tmp"
        removed=1
    fi
    if [ -n "$removed" ]; then log "removed the $TOOL Include from $SSH_MAIN"
    else log "no $TOOL Include found in $SSH_MAIN"; fi
    rm -f "$SSH_CONF"
    [ -z "$(ssh_other_includes)" ] || return 0
    if grep -qx config "$SSH_CREATED" 2>/dev/null \
        && [ -f "$SSH_MAIN" ] && [ ! -L "$SSH_MAIN" ] && [ ! -s "$SSH_MAIN" ]; then
        rm -f "$SSH_MAIN"; log "removed the now empty $SSH_MAIN"
    fi
    if grep -qx dir "$SSH_CREATED" 2>/dev/null && rmdir "$SSH_DIR" 2>/dev/null; then
        log "removed the now empty $SSH_DIR"
    fi
    rm -f "$SSH_CREATED"
}

# _proxy NAME: the ProxyCommand behind a `Host <prefix>NAME` stanza. `_proxy
# --missing` is the catch-all's and takes no host, so no hostname reaches a
# shell; a trailing argument is ignored.
# Prepares the session (host key re-pinned, pubkey re-pushed), then becomes
# sshd in the box. Stdout is the ssh byte stream: nothing is printed before
# the exec; outcomes go to $STATE/proxy.log (and stderr, which ssh relays).
cmd_proxy() {
    if [ "${1:-}" = --missing ]; then
        die "no $TOOL ssh stanza for this $HOST_PREFIX* host; run: $TOOL status, then $TOOL attach NAME (or $TOOL ssh-config)"
    fi
    name=${1:-}; [ -n "$name" ] || die "_proxy: NAME required"
    sess_exists "$name" || { proxy_log "$name" "fail: no session named $name"; die "no session named $name"; }
    (prepare "$name") || { proxy_log "$name" "fail: prepare"; exit 1; }
    d=$(sess_dir "$name")
    for f in sshd home; do
        stored_path "$name" $f >/dev/null || {
            proxy_log "$name" "fail: invalid $f in $d/$f"
            die "session $name: invalid $f in $d/$f; not using it"
        }
    done
    set --
    while IFS= read -r w; do set -- "$@" "$w"; done <<EOT
$(sshd_argv "$(stored_path "$name" sshd)" "$(stored_path "$name" home)")
EOT
    proxy_log "$name" ok
    exec "$MIN" session exec "$name" "$@"
}
# proxy_log NAME WHAT: one dated line in $STATE/proxy.log (mode 600; past
# 1000 lines only the newest 500 are kept). Silent and never fails: stdout is
# the ssh byte stream in _proxy, and a log problem must not block a connect.
proxy_log() {
    (
        f=$STATE/proxy.log; umask 077
        printf '%s %s %s\n' "$(date '+%FT%T')" "$1" "$2" >> "$f"
        chmod 600 "$f"
        [ "$(($(wc -l < "$f")))" -le 1000 ] || { tail -n 500 "$f" > "$f.$$" && mv -f "$f.$$" "$f"; } || rm -f "$f.$$"
    ) >/dev/null 2>&1 || true
}

# ssh NAME [-- ARGS...]: plain ssh into the session over the same transport.
cmd_ssh() {
    name=${1:-}; [ -n "$name" ] || die "ssh: NAME required"
    shift
    [ "${1:-}" = "--" ] && shift
    sess_exists "$name" || die "no session named $name"
    prepare "$name"
    d=$(sess_dir "$name")
    tmp=$(mktemp) && ssh_opts "$name" > "$tmp"
    set -- "$HOST_PREFIX$name" "$@"
    while IFS= read -r o; do set -- -o "$o" "$@"; done < "$tmp"
    rm -f "$tmp"
    hook client_on_connect "$name" || :
    exec ssh -i "$d/id_ed25519" "$@"
}

# ---- naming ----------------------------------------------------------------


# valid_name NAME: lowercase letters, digits and dashes, not starting with a
# dash: anything else breaks a `Host` pattern or a stanza comment.
valid_name() {
    case $1 in ''|-*) return 1 ;; esac
    [ "$(printf '%s.' "$1" | LC_ALL=C tr -d 'a-z0-9-')" = . ]
}

# pick_session CMD: numbered picker of own sessions on the terminal; prints the
# chosen name.
pick_session() {
    [ -t 0 ] || die "$1: NAME required when stdin is not a terminal"
    own_ls | jq -r '.sessions[] | [.name, .status, (.project_path // "")] | @tsv' \
        | awk -F'\t' '{ printf "%2d) %-28s %-13s %s\n", NR, $1, $2, $3 }' >&2
    printf 'session number: ' >&2
    read -r n
    case $n in ''|*[!0-9]*|0) die "no such entry" ;; esac
    pn=$(own_ls | jq -r --argjson n "$n" '.sessions[$n - 1].name // empty') \
        || die "no such entry"
    [ -n "$pn" ] || die "no such entry"
    valid_name "$pn" || die "session name is not lowercase letters, digits and dashes; not using it: $(printf '%s' "$pn" | LC_ALL=C tr -c '[:print:]' '?')"
    printf '%s\n' "$pn"
}

# default_loadouts: the names in min's default_loadouts (`[loadouts]` table
# or a top-level dotted `loadouts.default_loadouts`; "" or '' strings), one
# per line. Naming any --loadout makes min skip that list, so
# activate_session passes it on itself. What it cannot read, it says.
default_loadouts() {
    f=${XDG_CONFIG_HOME:-$HOME/.config}/minimal/config.toml
    [ -f "$f" ] || return 0
    raw=$(awk '
        /^[[:space:]]*\[/ && !on { hdr = 1; sec = ($0 ~ /^[[:space:]]*\[[[:space:]]*loadouts[[:space:]]*\][[:space:]]*(#.*)?$/); next }
        !on && ((sec && /^[[:space:]]*default_loadouts[[:space:]]*=/) \
                || (!hdr && /^[[:space:]]*loadouts[[:space:]]*\.[[:space:]]*default_loadouts[[:space:]]*=/)) { on = 1; sub(/^[^=]*=/, "") }
        on { sub(/#.*/, ""); print; if ($0 ~ /\]/) exit }' "$f")
    [ -n "$raw" ] || return 0
    dls=$(printf '%s\n' "$raw" | grep -oE "\"[^\"]*\"|'[^']*'" | sed "s/^.//; s/.\$//") || dls=
    if [ -z "$dls" ]; then
        [ -z "$(printf '%s' "$raw" | tr -d '[], \t\n')" ] || log "could not read default_loadouts in $f; activating with --loadout $LOADOUT only"
        return 0
    fi
    printf '%s\n' "$dls" | while IFS= read -r dl; do
        if printf '%s\n' "$dl" | grep -Eqx '[A-Za-z0-9._-]+'; then printf '%s\n' "$dl"
        else log "ignoring default loadout '$dl' in $f: not a plain name"; fi
    done
}

# activate_session NAME PATH [SYNC]: a new session for PATH with the user's
# default loadouts, then LOADOUT (last, so its settings win); SYNC is min's
# --sync mode (none: an empty /workbench). An empty NAME lets min name it
# (<dir>-<hex>): the one new session for PATH afterwards. Prints the name;
# min's own output goes to stderr.
activate_session() {
    an=$1 ap=$2 async=${3:-}
    before=$(min_ls | jq -r '.sessions[].name') || die "min ls failed"
    set --
    for al in $(default_loadouts); do
        case $al in
            "$LOADOUT") ;;
            *) set -- "$@" --loadout "$al" ;;
        esac
    done
    [ -z "$async" ] || set -- "$@" --sync "$async"
    set -- "$@" --loadout "$LOADOUT"
    [ -z "$an" ] || set -- "$@" -n "$an"
    mn session activate --no-prompt "$@" "$ap" >&2
    if [ -n "$an" ]; then
        sess_exists "$an" || die "activate made no session $an"
    else
        an=$(min_ls | jq -r --arg p "$ap" --arg b "$before" '($b | split("\n")) as $o
            | .sessions[] | select(.project_path == $p and (.name as $n | $o | index([$n]) | not)) | .name')
        case $(printf '%s\n' "$an" | grep -c .) in
            1) ;;
            0) die "activate made no session for $ap" ;;
            *) die "several new sessions for $ap: $(printf '%s' "$an" | tr '\n' ' ')" ;;
        esac
        valid_name "$an" || die "min named the session $(printf '%s' "$an" | LC_ALL=C tr -c '[:print:]' '?'), not a hostname; pass -n NAME"
    fi
    printf '%s\n' "$an"
}

# ---- lifecycle -------------------------------------------------------------

# min destroys a session with no unsaved changes without asking, so ask here
# first (default No). min still shows its own warning and delta listing for a
# session that has changes. ask_destroy NAME CHOICES prints the answer.
ask_destroy() {
    printf 'Destroy Minimal session %s (%s)? [%s] ' "$1" "$(sess_field "$1" project_path)" "$2" >&2
    IFS= read -r a || a=
    printf '%s' "$a"
}

# destroy_one NAME ANSWER [force]: destroy on y, else keep and snooze the
# tidy-up reminder for it (kept/NAME). force passes min's --force, which
# discards changes min has not saved. Returns min's exit status, or 4 when
# min refused for want of a terminal to confirm unsaved changes on (a
# client's call; on a terminal min asks itself).
# NAME counts as gone (keys and records dropped, client_on_destroy run) only
# when a min ls that succeeds no longer lists it. A failed min ls is
# unknown: everything stays (ssh-config is not rewritten), with a warning,
# and after a y the status is non-zero (min's own, or 1 when it was 0); a
# later `destroy NAME` drops what was kept once min ls lists NAME no more.
destroy_one() {
    r=0
    case $2 in
        y|Y|yes|YES)
            if [ -t 0 ]; then mn session destroy "$1" ${3:+--force} || r=$?
            else
                ef=$(mktemp "${TMPDIR:-/tmp}/$TOOL.XXXXXX") || die "mktemp failed"
                mn session destroy "$1" ${3:+--force} 2>"$ef" || r=$?
                cat "$ef" >&2
                if [ "$r" != 0 ] && grep -q 'without confirmation' "$ef"; then
                    log "$1 has changes min has not saved; destroy -y --force $1 discards them"; r=4
                fi
                rm -f "$ef"
            fi ;;
        *) log "kept $1"; mkdir -p "$STATE/kept"; date +%s > "$STATE/kept/$1" ;;
    esac
    if ! listed=$(ls_lists "$1"); then
        log "min ls failed, so whether $1 is gone is unknown; kept its keys"
        case $2 in y|Y|yes|YES) [ "$r" != 0 ] || r=1 ;; esac
        return "$r"
    fi
    [ "$listed" = true ] || drop_gone "$1"
    ssh_config_write
    return "$r"
}
# ls_lists NAME: true or false, from a min ls that succeeds; fails with it.
ls_lists() {
    ll_j=$(min_ls 2>/dev/null) || return 1
    printf '%s' "$ll_j" | jq -r --arg n "$1" 'any(.sessions[]; .name == $n)' 2>/dev/null
}
# drop_gone NAME: forget a box min no longer lists.
drop_gone() {
    rm -rf "$(sess_dir "$1")" "$STATE/orphan/$1" "$STATE/kept/$1"
    hook client_on_destroy "$1" || :
}

# Sessions whose box serves an ssh connection right now, one per line: any
# host process `min session exec NAME .../sshd` (_proxy, `ssh`, scp, any
# client's own ssh, whatever its Host prefix). Read from ps, so a stopped box
# is never started to ask.
in_use_names() {
    ps -xo pid=,ppid=,args= 2>/dev/null | awk '
        { k = split($0, w, /[ \t]+/)
          for (i = 1; i + 3 <= k; i++) {
              if (w[i] != "session" || w[i + 1] != "exec" || w[i + 2] !~ /^[a-z0-9][a-z0-9-]*$/) continue
              m = split(w[i + 3], q, "/"); if (q[m] == "sshd") { print w[i + 2]; break }
          } }' | sort -u
}
# gc_still_idle NAME: right before a gc asks about NAME, look again (the
# user may have connected while earlier questions were open): not in use,
# afresh, and not client_linked (the client must answer afresh too: clear
# any cache of its own before calling).
gc_still_idle() {
    INUSE_DONE=
    ! box_in_use "$1" && ! hook client_linked "$1"
}

# box_in_use NAME: NAME is in in_use_names, read once per run (track_orphans
# and gc_still_idle read it afresh).
box_in_use() {
    [ -n "${INUSE_DONE:-}" ] || { INUSE=$(in_use_names); INUSE_DONE=1; }
    printf '%s\n' "$INUSE" | grep -qxF -- "$1"
}

# track_orphans LS_JSON NOW: orphan/NAME = epoch an active session was first
# seen neither held by this client (client_linked) nor in use (box_in_use);
# a session in use restarts its age, so it counts from the last use. Removed
# once linked or no longer active. kept/NAME goes with the session. Prints the orphans not in use now, one per line.
track_orphans() {
    mkdir -p "$STATE/orphan" "$STATE/kept"
    INUSE_DONE=
    orphans=
    for n in $(printf '%s' "$1" | jq -r '.sessions[] | select(.status == "active") | .name'); do
        hook client_linked "$n" || orphans="$orphans$n
"
    done
    all=$(printf '%s' "$1" | jq -r '.sessions[].name')
    for n in $orphans; do
        if box_in_use "$n"; then printf '%s' "$2" > "$STATE/orphan/$n"; continue; fi
        [ -f "$STATE/orphan/$n" ] || printf '%s' "$2" > "$STATE/orphan/$n"
        printf '%s\n' "$n"
    done
    for f in "$STATE"/orphan/* "$STATE"/kept/*; do
        [ -f "$f" ] || continue
        n=${f##*/}
        case $f in
            "$STATE"/orphan/*) printf '%s\n' "$orphans" | grep -qxF -- "$n" || rm -f "$f" ;;
            *) printf '%s\n' "$all" | grep -qxF -- "$n" || rm -f "$f" ;;   # kept/
        esac
    done
}

# ---- report ----------------------------------------------------------------

# TSV on stdin -> space-aligned columns.
table() {
    awk -F'\t' '{ for (i = 1; i <= NF; i++) { c[NR, i] = $i; if (length($i) > w[i]) w[i] = length($i) } nf[NR] = NF }
        END { for (r = 1; r <= NR; r++) { s = ""
                  for (i = 1; i < nf[r]; i++) s = s sprintf("%-" w[i] "s  ", c[r, i])
                  print s c[r, nf[r]] } }'
}

# row LEVEL CHECK MESSAGE [FIX]
row() {
    printf '%-4s  %-11s  %s\n' "$1" "$2" "$3"
    [ "$1" = ok ] || [ -z "${4:-}" ] || printf '%19s%s\n' '' "$4"
    [ "$1" != FAIL ] || FAILS=$((FAILS + 1))
}
have() { command -v "$1" >/dev/null 2>&1; }

# 45m / 3h / 2d
humanise_age() {
    if [ "$1" -ge 86400 ]; then echo "$(($1 / 86400))d"
    elif [ "$1" -ge 3600 ]; then echo "$(($1 / 3600))h"
    else echo "$(($1 / 60))m"; fi
}

# ---- client constants: every editor-specific value ---------------------------
EDITOR_NAME=Zed
EDITOR_BIN=${MIN_ZED_EDITOR_BIN:-zed}             # host CLI that opens a window
EDITOR_APP=${MIN_ZED_EDITOR_APP:-/Applications/Zed.app}
# Without the zed command on PATH, the CLI inside the app.
if [ -z "${MIN_ZED_EDITOR_BIN:-}" ] && ! have "$EDITOR_BIN" && [ -x "$EDITOR_APP/Contents/MacOS/cli" ]; then
    EDITOR_BIN=$EDITOR_APP/Contents/MacOS/cli
fi
EDITOR_TESTED=1.26.2                               # the Zed release this tool was checked against
ZED_DIR=$HOME/.config/zed                          # Zed's config dir on the Mac
SETTINGS=${MIN_ZED_SETTINGS:-$ZED_DIR/settings.json}   # ssh_connections: the Remote Projects list
TASKS=${MIN_ZED_TASKS:-$ZED_DIR/tasks.json}            # global tasks: the Minimal tasks
KEYMAP=${MIN_ZED_KEYMAP:-$ZED_DIR/keymap.json}         # the local-terminal key
WORKDIR=/workbench                                   # folder the editor opens in the box

# ---- client settings ---------------------------------------------------------
MIN=                                                 # the min binary; main resolves it

usage() {
    cat <<USAGE
usage: $TOOL <command> [args]

  open [PATH] [-n NAME] [--no-window]
                          the session for PATH (default .): a live one of $TOOL's is reused, else
                          one is activated with --loadout $LOADOUT; then $EDITOR_NAME opens $WORKDIR in it
  new [PATH | --empty] [-n NAME] [--no-window]
                          always a new session for PATH, then $EDITOR_NAME; --empty: an empty
                          $WORKDIR (min names it box-...)
  attach [NAME] [--no-window]
                          an existing session in $EDITOR_NAME (no NAME: pick one of $TOOL's)
  destroy [-y] [--if-idle] [--force] [NAME]
                          destroy a session after a y/N prompt (-y skips it; --if-idle refuses,
                          exit 3, while something is connected). No NAME: this directory's, else
                          pick one. Without a terminal, a session with unsaved changes exits 4;
                          -y --force discards them
  gc [--older-than SECONDS] [--dry-run]
                          list active sessions no ssh client is using, then ask y/N/q for each
  status [--json]         table of sessions: status, project, in use, idle age
  setup [--remove]        install: link $TOOL into ~/.local/bin and the $LOADOUT loadout, copy
                          Minimal's skills, then ssh-config and config (--remove undoes only ours)
  doctor                  health report (ok / warn / FAIL with a fix); exits 1 on any FAIL
  config [--remove|--print]
                          opt in: ${HOST_PREFIX}* ssh_connections in $EDITOR_NAME's settings.json, the
                          Minimal tasks in tasks.json, the local-terminal key in keymap.json
                          (also: zed-config)
  ssh NAME [-- ARGS...]   plain ssh into the session with the same transport (debugging: -- -v)
  ssh-config [--remove|--print]
                          opt in: Host ${HOST_PREFIX}NAME stanzas in ~/.ssh/$TOOL.conf ($EDITOR_NAME needs them)
  completions <zsh|bash>  print a completion script

--no-window does everything but open the window.
USAGE
}

# ---- client hooks --------------------------------------------------------------

client_on_connect() { settings_sync; }
client_on_destroy() { rm -f "$STATE/created/$1"; settings_sync; }

# prepared_live: sessions with facts on disk (prepared by this tool) that min
# still lists, one per line; exit 1 when min ls fails, so no caller prunes
# on a partial list.
prepared_live() {
    ls_json=$(min_ls 2>/dev/null) || return 1
    live=$(printf '%s\n' "$ls_json" | jq -r '.sessions[].name') || return 1
    for s in "$STATE"/sessions/*/; do
        [ -f "${s}user" ] || continue
        n=$(basename "$s")
        valid_name "$n" || continue
        fact_ok "$USER_ERE" "$(cat "${s}user")" || continue
        printf '%s\n' "$live" | grep -qxF -- "$n" && printf '%s\n' "$n"
    done
    return 0
}

# real_self: this file itself, through ~/.local/bin symlinks ($SELF is the
# path we were run by, which stanzas keep).
real_self() {
    src=$SELF
    while [ -L "$src" ]; do
        l=$(readlink "$src"); case $l in /*) src=$l ;; *) src=$(dirname "$src")/$l ;; esac
    done
    printf '%s/%s' "$(cd "$(dirname "$src")" && pwd -P)" "$(basename "$src")"
}

# The merger next to this file (through ~/.local/bin symlinks).
config_bin() {
    printf '%s-config' "$(real_self)"
}

# run_config ARGS: the settings, tasks and keymap merger for this tool.
run_config() {
    "${PYTHON:-python3}" "$(config_bin)" --settings "$SETTINGS" --tasks "$TASKS" --keymap "$KEYMAP" \
        --state "$STATE" --prefix "$HOST_PREFIX" "$@"
}

# settings_sync: one ssh_connections entry per prepared live session (Zed's
# Remote Projects list); the tasks and keymap blocks only `config` writes.
# A no-op until `config` has run (or 0.1.0's `zed-config`, whose record the
# merger takes over), never fatal, and skipped when min ls fails (a partial
# list would drop entries).
settings_sync() {
    [ -f "$STATE/settings-installed" ] || [ -f "$STATE/zed-config-installed" ] || return 0
    have "${PYTHON:-python3}" || { log "python3 not found; $EDITOR_NAME settings not refreshed"; return 0; }
    names=$(prepared_live) || { log "min ls failed; $EDITOR_NAME settings not refreshed"; return 0; }
    # shellcheck disable=SC2086  # names are valid_name words
    run_config --sync $names >/dev/null || log "could not refresh $SETTINGS; see $TOOL doctor"
    return 0
}

# config [--remove|--print]: opt in to (or out of) the Zed wiring: the
# ssh_connections entries, the tasks block and the keymap block.
cmd_config() {
    case ${1:-} in
        '') set -- --install ;;
        --remove) set -- --remove ;;
        --print) set -- --install --dry-run ;;
        *) die "config: unknown option $1" ;;
    esac
    if names=$(prepared_live 2>/dev/null); then
        # shellcheck disable=SC2086
        run_config "$@" --sync $names
    else
        # a partial list would prune live entries: keep ours as they are
        [ "$1" = --remove ] || log "min ls failed; existing ${HOST_PREFIX}* entries left as they are"
        run_config "$@"
    fi
}

# setup_link LINK TARGET: LINK -> TARGET when LINK is missing, a dangling
# symlink, or a symlink to another copy of this tool's file (same basename: a
# checkout moved or cloned again). A regular file or a symlink to something
# else stays; returns 1.
setup_link() {
    if [ -L "$1" ]; then
        l=$(readlink "$1")
        [ "$l" != "$2" ] || return 0
        if [ -e "$1" ] && [ "${l##*/}" != "${2##*/}" ]; then
            log "leaving $1: it points to $l, not a copy of $TOOL's"; return 1
        fi
    elif [ -e "$1" ]; then
        log "leaving $1: not a symlink (move it aside, then run $TOOL setup again)"; return 1
    fi
    mkdir -p "$(dirname "$1")" && ln -sfn "$2" "$1" && log "linked $1 -> $2"
}

# setup_copy_dir DEST SRC: DEST becomes a copy of SRC, marked as ours
# (.TOOL-copy). min wants $LOADOUT_ROOT a real directory, so it cannot be a
# link. A DEST with no min-<client> mark is someone else's: left, returns 1.
# One with another min-<client>'s mark (a skill both install) is shared: the
# copy keeps every mark, and the last setup's files win.
setup_copy_dir() {
    if [ -e "$1" ] && ! copy_marks "$1" >/dev/null; then
        log "leaving $1: not made by $TOOL (move it aside, then run $TOOL setup again)"; return 1
    fi
    rm -rf "$1.new" && cp -R "$2" "$1.new" || return 1
    for m in $(copy_marks "$1"); do cp "$1/$m" "$1.new/$m" || return 1; done
    printf '%s\n' "$2" > "$1.new/.$TOOL-copy" && rm -rf "$1" && mv "$1.new" "$1" && log "copied $2 to $1"
}

# copy_marks DIR: the min-<client> marks in DIR (.min-vscode-copy, ...), one
# per line; fails when there are none.
copy_marks() {
    found=1
    for m in "$1"/.min-*-copy; do
        [ -f "$m" ] || continue
        printf '%s\n' "${m##*/}"; found=0
    done
    return "$found"
}

# setup [--remove]: the whole install from this checkout: ~/.local/bin/TOOL
# and the LOADOUT loadout linked here, its LOADOUT/ directory copied beside
# it, Minimal's host skills copied into ~/.agents/skills (Zed's agent) and
# ~/.claude/skills (Claude Code) on the Mac (boxes get minimal-sandbox from
# the loadout), then ssh-config and config, the two opt-in gates (config
# also writes the Minimal tasks and the local-terminal key, Zed's side of the
# UI). Re-running it follows this checkout to a new place. --remove undoes
# config and ssh-config and drops the links only when they point here.
cmd_setup() {
    ld=${XDG_CONFIG_HOME:-$HOME/.config}/minimal/loadouts/$LOADOUT.toml
    me=$(real_self)
    lo=$(cd "$(dirname "$me")/.." && pwd -P)/loadouts/$LOADOUT.toml
    ldd=${ld%.toml} lod=${lo%.toml}
    sko=$(dirname "$lo")/../skills
    cl=$HOME/.local/bin/$TOOL
    case ${1:-} in
        '') ;;
        --remove)
            # Zed's files first: while they still name our hosts and run our
            # CLI, the CLI and the ssh stanzas stay too
            cmd_config --remove \
                || die "setup --remove: $EDITOR_NAME's files still hold $TOOL's entries (see above); fix the file, then run $TOOL setup --remove again (nothing else was removed)"
            cmd_ssh_config --remove
            for pair in "$ld:$lo" "$cl:$me"; do
                f=${pair%%:*} t=${pair#*:}
                if [ -L "$f" ] && [ "$(readlink "$f")" = "$t" ]; then rm -f "$f"; log "removed $f"
                elif [ -e "$f" ] || [ -L "$f" ]; then log "leaving $f: it is not this copy's link"; fi
            done
            if [ -f "$ldd/.$TOOL-copy" ]; then rm -rf "$ldd"; log "removed $ldd"; fi
            for skd in "$HOME/.agents/skills" "$HOME/.claude/skills"; do
                for d in "$skd"/*/; do
                    d=${d%/}
                    [ -f "$d/.$TOOL-copy" ] || continue
                    rm -f "$d/.$TOOL-copy"
                    if others=$(copy_marks "$d"); then
                        log "left $d: also installed by $(printf '%s\n' "$others" | sed 's/^\.//; s/-copy$//' | paste -sd ' ' -)"
                    else rm -rf "$d"; log "removed $d"; fi
                done
                # the skills directory setup made, once nothing is left in it
                rmdir "$skd" 2>/dev/null && log "removed $skd"
            done
            log "left $STATE in place: it holds the session keys and backups"
            return 0 ;;
        *) die "setup: unknown option $1" ;;
    esac
    [ -f "$lo" ] || die "no $LOADOUT loadout next to $me ($lo)"
    [ -x "$me" ] || chmod +x "$me"
    rc=0
    setup_link "$cl" "$me" || rc=1
    setup_link "$ld" "$lo" || rc=1
    [ ! -d "$lod" ] || setup_copy_dir "$ldd" "$lod" || rc=1
    if [ -d "$sko" ]; then
        for skd in "$HOME/.agents/skills" "$HOME/.claude/skills"; do
            mkdir -p "$skd"
            for d in "$sko"/*/; do
                d=${d%/}
                setup_copy_dir "$skd/$(basename "$d")" "$(cd "$d" && pwd -P)" || rc=1
            done
        done
    fi
    cmd_ssh_config
    cmd_config || rc=1
    return "$rc"
}

# ---- editor --------------------------------------------------------------------

# editor_version: the host Zed's version (`zed --version`: "Zed 1.26.2 –
# /Applications/Zed.app"; a Preview build says "Zed Preview 1.27.0"), or nothing.
editor_version() {
    "$EDITOR_BIN" --version </dev/null 2>/dev/null | awk 'NR == 1 && $1 == "Zed" {
        if ($2 == "Preview") print "Preview", $3; else print $2 }'
}

# launch NAME: the editor window on WORKDIR in the box.
launch() {
    have "$EDITOR_BIN" || die "$EDITOR_BIN not found: $EDITOR_NAME > Install CLI, or set ${ENV_PREFIX}_EDITOR_BIN"
    dbg "$EDITOR_BIN ssh://$HOST_PREFIX$1$WORKDIR"
    "$EDITOR_BIN" "ssh://$HOST_PREFIX$1$WORKDIR" </dev/null >/dev/null \
        || die "$EDITOR_BIN could not open ssh://$HOST_PREFIX$1$WORKDIR"
    log "opened $HOST_PREFIX$1 in $EDITOR_NAME"
}

# connect NAME [nowindow]: prepare, settings, window (unless nowindow).
connect() {
    [ -f "$SSH_CONF" ] || die "$EDITOR_NAME reaches the box as ssh $HOST_PREFIX$1: run $TOOL ssh-config first ($TOOL setup does)"
    prepare "$1"
    hook client_on_connect "$1"
    [ -n "${2:-}" ] || launch "$1"
}

# ---- commands --------------------------------------------------------------------

# open|new [PATH] [-n NAME] [--no-window]; new --empty: an empty box on
# $STATE/box, so min names it box-<hex>.
cmd_open() {
    mode=$1; shift
    path=. name='' gave='' nowin='' empty=''
    while [ $# -gt 0 ]; do
        case $1 in
            -n|--name) [ $# -ge 2 ] || die "$mode: -n needs a NAME"; name=$2; shift 2 ;;
            --no-window) nowin=1; shift ;;
            --empty) [ "$mode" = new ] || die "$mode: unknown option $1"; empty=1; shift ;;
            -*) die "$mode: unknown option $1" ;;
            *) path=$1 gave=1; shift ;;
        esac
    done
    [ -z "$name" ] || valid_name "$name" || die "session name must be lowercase letters, digits and dashes: $name"
    if [ -n "$empty" ]; then
        [ -z "$gave" ] || die "new: --empty takes no PATH"
        path=$STATE/box
        mkdir -p "$path"
    fi
    [ -d "$path" ] || die "not a directory: $path"
    path=$(CDPATH='' cd -P -- "$path" && pwd -P)
    [ -f "$SSH_CONF" ] || die "$EDITOR_NAME reaches the box as ssh ${HOST_PREFIX}NAME: run $TOOL ssh-config first ($TOOL setup does)"
    if [ "$mode" = open ] && [ -z "$name" ]; then
        name=$(own_ls | jq -r --arg p "$path" '[.sessions[] | select(.status == "active" and .project_path == $p
            and (.name | test("^[a-z0-9][a-z0-9-]*$"))) | .name][0] // empty')
    elif [ -n "$name" ] && [ -n "$gave" ] && sess_exists "$name" && [ "$(sess_field "$name" project_path)" != "$path" ]; then
        die "session $name is for $(sess_field "$name" project_path), not $path"
    fi
    if [ -z "$name" ] || ! sess_exists "$name"; then
        name=$(activate_session "$name" "$path" ${empty:+none}) || exit 1
        mkdir -p "$STATE/created" && : > "$STATE/created/$name"
    elif [ "$mode" = new ]; then
        die "session $name already exists; $TOOL attach $name"
    fi
    connect "$name" "$nowin"
    printf '%s%s\n' "$HOST_PREFIX" "$name"
}

cmd_attach() {
    name='' nowin=''
    while [ $# -gt 0 ]; do
        case $1 in
            --no-window) nowin=1; shift ;;
            -*) die "attach: unknown option $1" ;;
            *) name=$1; shift ;;
        esac
    done
    [ -n "$name" ] || name=$(pick_session attach)
    sess_exists "$name" || die "no session named $name"
    connect "$name" "$nowin"
    printf '%s%s\n' "$HOST_PREFIX" "$name"
}

# destroy [-y] [--if-idle] [--force] [NAME]. No NAME: the own session for the
# cwd; on a terminal (a Zed task's), when there is not exactly one, the
# attach picker of own sessions. --if-idle is for a client that asked its own
# question: it looks again right before destroying (gc_still_idle) and
# refuses with exit 3 when something connected meanwhile. Without a
# terminal, min refuses a session with unsaved changes: exit 4, and the
# client asks again before -y --force discards them.
cmd_destroy() {
    yes='' ifidle='' force='' name=''
    while [ $# -gt 0 ]; do
        case $1 in
            -y|--yes) yes=1; shift ;;
            --if-idle) ifidle=1; shift ;;
            --force) force=1; shift ;;
            -*) die "destroy: unknown option $1" ;;
            *) name=$1; shift ;;
        esac
    done
    if [ -z "$name" ]; then
        here=$(pwd -P)
        own=$(own_ls) || die "min ls failed"
        name=$(printf '%s' "$own" | jq -r --arg p "$here" '.sessions[] | select(.project_path == $p) | .name')
        case $(printf '%s\n' "$name" | grep -c .) in
            1) ;;
            0) { [ -t 0 ] && [ -n "$(printf '%s' "$own" | jq -r '.sessions[].name')" ]; } \
                   || die "no session for $here; pass NAME"
               name=$(pick_session destroy) ;;
            *) [ -t 0 ] || die "several sessions for $here: $(printf '%s' "$name" | tr '\n' ' '); pass NAME"
               log "several sessions for $here: $(printf '%s' "$name" | tr '\n' ' '); pick one"
               name=$(pick_session destroy) ;;
        esac
    fi
    [ -z "$force" ] || [ -n "$yes" ] || die "destroy: --force needs -y"
    if ! sess_exists "$name"; then
        # keys a failed min ls kept (destroy_one) for a box now gone
        if valid_name "$name" && [ -d "$(sess_dir "$name")" ]; then
            listed=$(ls_lists "$name") || die "min ls failed; kept the keys of $name"
            if [ "$listed" = false ]; then
                drop_gone "$name"; ssh_config_write
                log "$name is gone; removed its keys"; exit 0
            fi
        fi
        die "no session named $name"
    fi
    if [ -n "$ifidle" ] && ! gc_still_idle "$name"; then
        log "$name is in use now; not destroying"; exit 3
    fi
    answer=y
    [ -n "$yes" ] || answer=$(ask_destroy "$name" y/N)
    rc=0
    destroy_one "$name" "$answer" "$force" || rc=$?
    exit "$rc"
}

# gc: offer to destroy each active session no ssh client is using, oldest first.
cmd_gc() {
    older=0 dry=
    while [ $# -gt 0 ]; do
        case $1 in
            --older-than) [ $# -ge 2 ] || die "gc: --older-than needs SECONDS"; older=$2; shift 2 ;;
            --dry-run) dry=1; shift ;;
            *) die "gc: unknown argument $1" ;;
        esac
    done
    case $older in ''|*[!0-9]*) die "gc: --older-than takes whole seconds" ;; esac
    now=$(date +%s)
    own=$(own_ls) || die "min ls failed"
    # idle ages count from the first gc or status that saw the session unused
    track_orphans "$own" "$now" >/dev/null
    # since<TAB>name<TAB>project. A session not dated yet has an unknown age:
    # it counts only when no threshold is given.
    rows=$(printf '%s' "$own" | jq -r '.sessions[] | select(.status == "active") | [.name, (.project_path // "-")] | @tsv' \
        | while IFS='	' read -r n p; do
              ! box_in_use "$n" || continue
              ! hook client_linked "$n" || continue
              since=$(cat "$STATE/orphan/$n" 2>/dev/null || true)
              if [ -n "$since" ]; then [ $((now - since)) -ge "$older" ] || continue
              else [ "$older" = 0 ] || continue; since=$now; fi
              printf '%s\t%s\t%s\n' "$since" "$n" "$p"
          done | sort -n)
    rc=0
    if [ -z "$rows" ]; then
        echo "no active sessions without an ssh client"
    else
        { printf 'NAME\tPROJECT\tIDLE\n'
          printf '%s\n' "$rows" | while IFS='	' read -r since n p; do
              a=-; [ -f "$STATE/orphan/$n" ] && a=$(humanise_age $((now - since)))
              printf '%s\t%s\t%s\n' "$n" "$p" "$a"
          done; } | table
        if [ -z "$dry" ]; then
            for n in $(printf '%s\n' "$rows" | cut -f2); do
                gc_still_idle "$n" || { log "$n is in use now; not asking"; continue; }
                answer=$(ask_destroy "$n" y/N/q)
                case $answer in q|Q) break ;; esac
                destroy_one "$n" "$answer" || rc=$?
            done
        fi
    fi
    exit "$rc"
}

# status [--json]. --json: one object per session whose name is a valid
# hostname: name, status, project, own (prepared by this tool), empty (made
# by new --empty), in_use, idle (seconds since first seen unused, or null).
cmd_status() {
    case ${1:-} in '') json= ;; --json) json=1 ;; *) die "status: unknown option $1" ;; esac
    now=$(date +%s)
    ls_json=$(min_ls) || die "min ls failed"
    track_orphans "$(printf '%s' "$ls_json" | own_filter)" "$now" >/dev/null
    if [ -n "$json" ]; then
        printf '%s' "$ls_json" | jq -r '.sessions[] | [.name, .status, (.project_path // "")] | @tsv' \
            | while IFS='	' read -r n s p; do
                  valid_name "$n" || continue
                  u=false; box_in_use "$n" && u=true
                  a=null; [ "$u" = false ] && [ -f "$STATE/orphan/$n" ] && a=$((now - $(cat "$STATE/orphan/$n")))
                  o=false; [ -d "$(sess_dir "$n")" ] && o=true
                  jq -nc --arg n "$n" --arg s "$s" --arg p "$p" --argjson u "$u" --argjson a "$a" \
                      --argjson o "$o" --arg sb "$STATE/box" \
                      '{name: $n, status: $s, project: $p, own: $o, empty: ($p == $sb), in_use: $u, idle: $a}'
              done | jq -s .
        return
    fi
    { printf 'SESSION\tSTATUS\tPROJECT\tIN USE\tIDLE\n'
      printf '%s' "$ls_json" | jq -r '.sessions[] | [.name, .status, (.project_path // "-")] | @tsv' \
        | while IFS='	' read -r n s p; do
              u=no; box_in_use "$n" && u=yes
              a=-; [ "$u" = no ] && [ -f "$STATE/orphan/$n" ] && a=$(humanise_age $((now - $(cat "$STATE/orphan/$n"))))
              printf '%s\t%s\t%s\t%s\t%s\n' "$n" "$s" "$p" "$u" "$a"
          done; } | table
}

min_version() { mn version </dev/null 2>/dev/null | awk '$1 == "Client:" { print $3; exit }'; }
MIN_MINIMUM=0.7   # oldest min release this tool supports (major.minor)

# min_new_enough VERSION: VERSION's major.minor is at least MIN_MINIMUM
# (0.7.0, 0.7.3, 0.8.0-dev.241.g7097b969 all pass).
min_new_enough() {
    case $1 in [0-9]*.[0-9]*) ;; *) return 1 ;; esac
    vm=${1%%.*} vn=${1#*.}; vn=${vn%%[!0-9]*}
    mm=${MIN_MINIMUM%%.*} mn_=${MIN_MINIMUM#*.}
    [ "$vm" -gt "$mm" ] || { [ "$vm" -eq "$mm" ] && [ "$vn" -ge "$mn_" ]; }
}

cmd_doctor() {
    FAILS=0
    cfgdir=${XDG_CONFIG_HOME:-$HOME/.config}

    MIN=$(resolve_min 2>/dev/null) || MIN=
    if [ -n "$MIN" ]; then
        v=$(min_version)
        if min_new_enough "$v"; then row ok min "$MIN $v"
        else row FAIL min "$MIN version ${v:-unknown}; $TOOL needs min $MIN_MINIMUM.0 or newer" "upgrade Minimal"; fi
    else
        row FAIL min "min not found" "install Minimal, or set MIN_BIN to the min binary"
    fi

    if have "$EDITOR_BIN"; then
        v=$(editor_version)
        case $v in
            "$EDITOR_TESTED") row ok editor "$EDITOR_NAME $v ($EDITOR_BIN)" ;;
            *) row ok editor "$EDITOR_NAME ${v:-version unknown} ($EDITOR_BIN); $TOOL was tested with $EDITOR_TESTED" ;;
        esac
    else
        row FAIL editor "$EDITOR_BIN not found" "$EDITOR_NAME > Install CLI (or set ${ENV_PREFIX}_EDITOR_BIN)"
    fi

    missing=
    for t in jq python3 ssh; do have "$t" || missing="$missing $t"; done
    if [ -z "$missing" ]; then row ok tools "jq, python3, ssh"
    else row FAIL tools "missing:$missing" "install$missing"; fi

    l="$cfgdir/minimal/loadouts/$LOADOUT.toml"
    if [ ! -e "$l" ]; then
        row FAIL loadout "$l missing" "$TOOL setup"
    elif [ -n "$MIN" ] && ! mn loadout list --config-dir "$cfgdir" </dev/null 2>/dev/null \
            | awk -v n="$LOADOUT" '$1 == n || ($1 == "*" && $2 == n) { f = 1 } END { exit !f }'; then
        row FAIL loadout "min loadout list does not show $LOADOUT" "check $l parses: min loadout list"
    else
        row ok loadout "$LOADOUT installed (sessions get it via --loadout $LOADOUT)"
    fi

    if mkdir -p "$STATE" 2>/dev/null && [ -w "$STATE" ]; then row ok "state dir" "$STATE"
    else row FAIL "state dir" "$STATE not writable" "fix permissions, or set ${ENV_PREFIX}_STATE_DIR"; fi

    inc=; grep -qxF -- "$SSH_MARK2" "$SSH_MAIN" 2>/dev/null && inc=1
    if [ -n "$inc" ] && [ -f "$SSH_CONF" ]; then
        row ok ssh-config "$(ssh_stanza_count) stanza(s) in $SSH_CONF"
        first=$(stanza_names | head -1)
        pc=
        if [ -z "$first" ]; then :
        elif out=$(ssh -G -F "$SSH_MAIN" "$HOST_PREFIX$first" 2>&1); then
            pc=$(printf '%s\n' "$out" | awk '$1 == "proxycommand"')
        else
            row warn ssh-config "ssh -G -F $SSH_MAIN $HOST_PREFIX$first fails: $(printf '%s\n' "$out" | tail -1)" "fix the quoted line, or $TOOL ssh-config --remove"
        fi
        case $pc in
            ''|*_proxy*) ;;
            *) row warn ssh-config "ssh -G does not route $HOST_PREFIX$first via $TOOL; an earlier Host/Match block may shadow it" "move the $TOOL Include above every Host/Match in $SSH_MAIN" ;;
        esac
    elif [ -z "$inc" ] && [ ! -e "$SSH_CONF" ]; then
        row FAIL ssh-config "not installed; $EDITOR_NAME cannot reach a box" "$TOOL ssh-config"
    elif [ -n "$inc" ]; then
        row warn ssh-config "$SSH_MAIN includes $SSH_CONF, which is missing" "$TOOL ssh-config"
    else
        row warn ssh-config "$SSH_CONF exists but $SSH_MAIN does not include it" "$TOOL ssh-config"
    fi

    # settings (ssh_connections), tasks and keymap rows, from the merger
    if have python3; then
        if names=$(prepared_live 2>/dev/null); then hosts=1
        else
            hosts='' names=''
            row warn settings "min ls failed; ${HOST_PREFIX}* entries not checked" "min ls --json"
        fi
        # shellcheck disable=SC2086
        out=$(run_config --doctor $names 2>&1) || out="settings	FAIL	$TOOL-config --doctor failed: $(printf '%s' "$out" | tail -1)"
        while IFS='	' read -r chk lvl msg fix; do
            [ -n "$lvl" ] || continue
            [ -n "$hosts" ] || [ "$chk" != settings ] || continue
            row "$lvl" "$chk" "$msg" "$fix"
        done <<EOT
$out
EOT
    fi

    # Minimal's host skills, for the agents on the Mac
    sko=$(cd "$(dirname "$(real_self)")/.." && pwd -P)/skills
    if [ -d "$sko" ]; then
        want=$(for d in "$sko"/*/; do [ ! -d "$d" ] || basename "$d"; done)
        miss=
        for skd in "$HOME/.agents/skills" "$HOME/.claude/skills"; do
            for n in $want; do [ -f "$skd/$n/SKILL.md" ] || miss="$miss $skd/$n"; done
        done
        if [ -z "$miss" ]; then row ok skills "$(printf '%s\n' "$want" | grep -c .) in ~/.agents/skills and ~/.claude/skills"
        else row warn skills "missing:$miss" "$TOOL setup"; fi
    fi

    if [ -n "$MIN" ] && have jq; then
        other=$(for s in "$STATE"/sessions/*/; do
                    [ -f "${s}user" ] || continue
                    n=$(basename "$s"); [ -e "$STATE/created/$n" ] || printf ' %s' "$n"
                done)
        if [ -n "$other" ]; then
            row warn sessions "not activated by $TOOL (no --loadout $LOADOUT):$other" "fine for plain editing; for the loadout: min session activate --loadout $LOADOUT"
        fi
    fi

    [ "$FAILS" -eq 0 ]
}

cmd_completions() {
    case ${1:-} in
        zsh) sed "s/@TOOL@/$TOOL/g; s/@FN@/$(printf '%s' "$TOOL" | tr - _)/g" <<'ZSH'
#compdef @TOOL@
_@FN@() {
    local -a cmds sess
    cmds=(open new attach destroy gc status doctor config setup ssh ssh-config completions)
    if (( CURRENT == 2 )); then
        compadd -a cmds
        return
    fi
    case $words[2] in
        open) _arguments '-n[session name]:name:' '--no-window[do not open a window]' '1:path:_directories' ;;
        new) _arguments '-n[session name]:name:' '--no-window[do not open a window]' '--empty[an empty box]' '1:path:_directories' ;;
        attach) sess=(${(f)"$(@TOOL@ _sessions 2>/dev/null)"}); compadd -- --no-window; compadd -a sess ;;
        destroy)
            sess=(${(f)"$(@TOOL@ _sessions 2>/dev/null)"})
            compadd -- -y --if-idle --force
            compadd -a sess ;;
        status) compadd -- --json ;;
        setup) compadd -- --remove ;;
        ssh)
            (( ${words[(I)--]} )) && return
            if (( CURRENT == 3 )); then
                sess=(${(f)"$(@TOOL@ _sessions 2>/dev/null)"}); compadd -a sess
            else
                compadd -- --
            fi ;;
        ssh-config|config|zed-config) compadd -- --remove --print ;;
        gc) [[ $words[CURRENT-1] == --older-than ]] || compadd -- --older-than --dry-run ;;
        completions) compadd zsh bash ;;
    esac
}
compdef _@FN@ @TOOL@
ZSH
        ;;
        bash) sed "s/@TOOL@/$TOOL/g; s/@FN@/$(printf '%s' "$TOOL" | tr - _)/g" <<'BASH'
_@FN@() {
    local cur=${COMP_WORDS[COMP_CWORD]} prev=${COMP_WORDS[COMP_CWORD-1]} sub=${COMP_WORDS[1]:-} w
    local IFS=$'\n'
    COMPREPLY=()
    if [ "$COMP_CWORD" -eq 1 ]; then
        COMPREPLY=($(compgen -W "open new attach destroy gc status doctor config setup ssh ssh-config completions" -- "$cur"))
        return
    fi
    case $sub in
        open|new)
            if [ "$prev" = -n ]; then return; fi
            w=$'-n\n--no-window'; [ "$sub" = new ] && w+=$'\n--empty'
            COMPREPLY=($(compgen -d -- "$cur") $(compgen -W "$w" -- "$cur")) ;;
        attach) COMPREPLY=($(compgen -W $'--no-window\n'"$(@TOOL@ _sessions 2>/dev/null)" -- "$cur")) ;;
        destroy) COMPREPLY=($(compgen -W $'-y\n--if-idle\n--force\n'"$(@TOOL@ _sessions 2>/dev/null)" -- "$cur")) ;;
        status) COMPREPLY=($(compgen -W "--json" -- "$cur")) ;;
        setup) COMPREPLY=($(compgen -W "--remove" -- "$cur")) ;;
        ssh)
            for w in "${COMP_WORDS[@]:2:COMP_CWORD-2}"; do [ "$w" = -- ] && return; done
            if [ "$COMP_CWORD" -eq 2 ]; then
                COMPREPLY=($(compgen -W "$(@TOOL@ _sessions 2>/dev/null)" -- "$cur"))
            else
                COMPREPLY=($(compgen -W "--" -- "$cur"))
            fi ;;
        ssh-config|config|zed-config) COMPREPLY=($(compgen -W "--remove --print" -- "$cur")) ;;
        gc)
            if [ "$prev" = --older-than ]; then return; fi
            COMPREPLY=($(compgen -W "--older-than --dry-run" -- "$cur")) ;;
        completions) COMPREPLY=($(compgen -W "zsh bash" -- "$cur")) ;;
    esac
}
complete -F _@FN@ @TOOL@
BASH
        ;;
        *) die "completions: expected zsh or bash" ;;
    esac
}

# ---- main ------------------------------------------------------------------------

[ $# -ge 1 ] || { usage >&2; exit 2; }
cmd=$1; shift
case $cmd in
    -h|--help|help) usage; exit 0 ;;
    doctor) cmd_doctor "$@"; exit $? ;;
    completions) cmd_completions "$@"; exit 0 ;;
    ssh-config) MIN=$(resolve_min 2>/dev/null) || MIN=; cmd_ssh_config "$@"; exit 0 ;;
    config|zed-config) MIN=$(resolve_min 2>/dev/null) || MIN=; mkdir -p "$STATE"; cmd_config "$@"; exit $? ;;
    setup) MIN=$(resolve_min 2>/dev/null) || MIN=; mkdir -p "$STATE"; cmd_setup "$@"; exit $? ;;
    _proxy) [ "${1:-}" != --missing ] || cmd_proxy "$@" ;;   # --missing always dies; needs no min
esac
MIN=$(resolve_min)
mkdir -p "$STATE"
case $cmd in
    open) cmd_open open "$@" ;;
    new) cmd_open new "$@" ;;
    attach) cmd_attach "$@" ;;
    destroy) cmd_destroy "$@" ;;
    gc) cmd_gc "$@" ;;
    ssh) cmd_ssh "$@" ;;
    status) cmd_status "$@" ;;
    _sessions) own_ls | jq -r '.sessions[].name' ;;
    _proxy) cmd_proxy "$@" ;;
    *) usage >&2; exit 2 ;;
esac
